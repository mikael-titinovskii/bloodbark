{#
    Fallback for every error that has no `error<status>.html.twig` of its own (403, 405, 500, …).
    Same reasoning as error404.html.twig: the page keeps the site chrome instead of falling back to
    Symfony's bare built-in page.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.generic.title'|trans }}{% endblock %}

{% block body %}
    <div class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{{ 'error.generic.title'|trans }}</h1>
        <p class="mt-3 text-sm text-stone-700">{{ 'error.generic.text'|trans }}</p>
        <a href="{{ path('app_home') }}" class="mt-6 inline-block text-sm font-medium text-rose-700 underline-offset-4 hover:underline">{{ 'error.back_home'|trans }}</a>
    </div>
{% endblock %}
