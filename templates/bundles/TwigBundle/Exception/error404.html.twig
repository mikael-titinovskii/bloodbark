{#
    TwigBundle renders `@Twig/Exception/error404.html.twig` when the kernel is not in debug (in
    debug/development the profiler exception page takes over, so this is not what `make ee` shows).
    Overriding it here keeps the site chrome, the scope banner and the bundle on a 404.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans }}{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'error.404.title'|trans }}</h1>
        <p>{{ 'error.404.text'|trans }}</p>
        <p>{{ 'emergency.notice'|trans }}</p>
        <p><a href="{{ path('app_home') }}">{{ 'error.back_home'|trans }}</a></p>
    </main>
{% endblock %}
