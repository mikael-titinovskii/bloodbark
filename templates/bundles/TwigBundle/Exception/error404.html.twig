{#
    TwigBundle renders `@Twig/Exception/error404.html.twig` when the kernel is not in debug (in
    debug/development the profiler exception page takes over, so this is not what `make ee` shows).
    Overriding it here keeps the site chrome, the scope banner and the bundle on a 404.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans }}{% endblock %}

{% block body %}
    <div class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold tracking-widest text-stone-400">404</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-stone-900">{{ 'error.404.title'|trans }}</h1>
        <p class="mt-3 text-sm text-stone-700">{{ 'error.404.text'|trans }}</p>
        <a href="{{ path('app_home') }}" class="mt-6 inline-block text-sm font-medium text-rose-700 underline-offset-4 hover:underline">{{ 'error.back_home'|trans }}</a>
    </div>
{% endblock %}
