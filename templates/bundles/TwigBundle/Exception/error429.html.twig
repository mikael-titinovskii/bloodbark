{#
    Rendered by TwigBundle for a 429 (the rate limiter refusing a request), same reasoning as
    error404.html.twig: keep the site chrome rather than dropping to Symfony's bare page. The
    bundle hands the template `status_code`, `status_text` and `exception`; none are needed here.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.429.title'|trans }}{% endblock %}

{% block body %}
    <div class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold tracking-widest text-stone-400">429</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-stone-900">{{ 'error.429.title'|trans }}</h1>
        <p class="mt-3 text-sm text-stone-700">{{ 'error.429.text'|trans }}</p>
        <a href="{{ path('app_home') }}" class="mt-6 inline-block text-sm font-medium text-rose-700 underline-offset-4 hover:underline">{{ 'error.back_home'|trans }}</a>
    </div>
{% endblock %}
