{#
    Sent by App\Mailer\PasswordResetMailer. `resetUrl` is the only copy of the token: the database
    holds its hash, and the link stops working as soon as the new password is saved.
#}
<!doctype html>
<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{{ 'reset.email.subject'|trans }}</title>
    </head>
    <body>
        <p>{{ 'email.greeting'|trans }}</p>

        <p>{{ 'reset.email.intro'|trans({'%email%': address}) }}</p>

        <p><a href="{{ resetUrl }}">{{ resetUrl }}</a></p>

        <p>{{ 'reset.email.expiry'|trans({'%hours%': hours}) }}</p>

        <p>{{ 'reset.email.security'|trans }}</p>

        <p>{{ 'email.signature'|trans }}</p>
    </body>
</html>
