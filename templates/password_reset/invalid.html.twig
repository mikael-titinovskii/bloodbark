{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.invalid.title'|trans }} · Bloodbark{% endblock %}

{% block body %}
    <div class="mx-auto max-w-xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{{ 'reset.invalid.title'|trans }}</h1>
        <p class="mt-3 text-sm text-stone-700">{{ 'reset.invalid.text'|trans }}</p>
        <p class="mt-6 text-sm">
            <a href="{{ path('app_forgot_password') }}" class="font-medium text-rose-700 underline-offset-2 hover:underline">{{ 'reset.invalid.action'|trans }}</a>
        </p>
    </div>
{% endblock %}
