{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.sent.title'|trans }} · Bloodbark{% endblock %}

{% block body %}
    <div class="mx-auto max-w-xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{{ 'reset.sent.title'|trans }}</h1>
        {# Deliberately the same sentence for a known and an unknown address. #}
        <p class="mt-3 text-sm text-stone-700">{{ 'reset.sent.text'|trans({'%hours%': hours}) }}</p>
        <p class="mt-2 text-xs text-stone-500">{{ 'reset.sent.hint'|trans }}</p>
        <p class="mt-6 text-sm"><a href="{{ path('app_login') }}" class="font-medium text-rose-700 underline-offset-2 hover:underline">{{ 'login.title'|trans }}</a></p>
    </div>
{% endblock %}
