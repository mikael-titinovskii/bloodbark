{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.title'|trans }} · Bloodbark{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{{ 'reset.title'|trans }}</h1>
        <p class="mt-2 text-sm text-stone-600">{{ 'reset.intro'|trans }}</p>

        {{ form_start(form, {attr: {class: 'mt-8 space-y-5 rounded-xl border border-stone-200 bg-white p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.submit) }}
        {{ form_end(form) }}

        <p class="mt-6 text-sm text-stone-600">
            <a href="{{ path('app_login') }}" class="font-medium text-rose-700 underline-offset-2 hover:underline">{{ 'reset.back_to_login'|trans }}</a>
        </p>
    </div>
{% endblock %}
