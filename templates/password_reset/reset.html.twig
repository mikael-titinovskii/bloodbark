{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.new_title'|trans }} · Bloodbark{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <h1 class="text-2xl font-semibold tracking-tight text-stone-900">{{ 'reset.new_title'|trans }}</h1>
        <p class="mt-2 text-sm text-stone-600">{{ 'reset.new_intro'|trans({'%email%': email}) }}</p>

        {{ form_start(form, {attr: {class: 'mt-8 space-y-5 rounded-xl border border-stone-200 bg-white p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.submit) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
